<div class="weather-app">
  <header class="app-header">
    <div class="brand">
      <div class="brand-icon">☀</div>
      <span>Weather Forecast</span>
    </div>

    <span class="header-label">US WEATHER</span>
  </header>

  <main class="main-content">
    <div class="page-intro">
      <h1>Weather, wherever you are.</h1>
      <p>Enter a US address to check the weather forecast.</p>
    </div>

    <section class="search-card">
      <%= form_with url: root_path, method: :get,
                    html: { class: "search-form" } do |form| %>

        <div class="form-group">
          <%= form.label :address, "Full Address", class: "form-label" %>

          <%= form.text_field :address,
                value: @address,
                placeholder: "1600 Pennsylvania Avenue NW, Washington, DC",
                required: true,
                class: "address-input" %>
        </div>

        <%= form.submit "Get Forecast", class: "search-button" %>
      <% end %>
    </section>

    <% if @error.present? %>
      <div class="error-message" role="alert">
        <span class="error-icon">!</span>
        <span><%= @error %></span>
      </div>
    <% end %>

    <% if @forecast.present? %>
      <section class="forecast-card">

        <div class="forecast-header">
          <div>
            <h2>
              <%= @forecast[:city] %>,
              <%= @forecast[:state] %>
            </h2>

            <p class="zip-code">
              ZIP Code: <%= @forecast[:zip_code] %>
            </p>
          </div>

          <% if @from_cache %>
            <span class="cache-badge cached">
              ● Cached result
            </span>
          <% else %>
            <span class="cache-badge fresh">
              ● Fresh forecast
            </span>
          <% end %>
        </div>

        <div class="current-weather">
          <div class="weather-icon" aria-hidden="true">⛅</div>

          <div class="temperature-info">
            <h3>Current Temperature</h3>

            <p class="current-temperature">
              <strong>
                <%= @forecast[:temperature] %><%= @forecast[:unit] %>
              </strong>
            </p>
          </div>
        </div>

        <div class="temperature-details">
          <div class="temperature-detail">
            <div class="detail-icon high-icon">↑</div>

            <div>
              <span class="detail-label">Today's high</span>

              <p class="detail-value">
                High:
                <%= @forecast[:high] %><%= @forecast[:unit] %>
              </p>
            </div>
          </div>

          <div class="temperature-detail">
            <div class="detail-icon low-icon">↓</div>

            <div>
              <span class="detail-label">Today's low</span>

              <p class="detail-value">
                Low:
                <%= @forecast[:low] %><%= @forecast[:unit] %>
              </p>
            </div>
          </div>
        </div>

        <div class="forecast-footer">
          <% if @from_cache %>
            <p>
              Cached result — updated within the last
              <%= @cache_time %> minutes
            </p>
          <% else %>
            <p>Fresh forecast</p>
          <% end %>
        </div>

      </section>
    <% end %>
  </main>

  <footer class="app-footer">
    <p>Weather data provided by Open-Meteo.</p>
    <p>Location data © OpenStreetMap contributors.</p>
  </footer>
</div>